{
  "name": "stillframe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "start": "npm run dev",
    "validate": "node --experimental-strip-types scripts/validate-gallery.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "npm run validate && npm run images && tsc --noEmit && vite build && node scripts/prerender.mjs && node scripts/check-static-output.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "images": "node scripts/prepare-images.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "sharp": "0.35.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
